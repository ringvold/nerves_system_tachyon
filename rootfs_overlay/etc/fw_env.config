# fw_printenv and fw_setenv configuration
#
# This is the REAL U-Boot environment on this platform. U-Boot loads and
# saves it from the start of the uboot_env partition (/dev/sda3), and the
# Nerves A/B slot selection logic depends on it. Keep in sync with
# fwup_include/fwup-common.conf (UBOOT_ENV_OFFSET) and
# uboot/nerves.fragment (CONFIG_ENV_SCSI_HW_PARTITION, CONFIG_ENV_SIZE).
#
# 0x22000000 = 544 MiB = start of /dev/sda3 on UFS LUN 0 (4096-byte sectors)

# Device name	Device offset	Env. size	Flash sector size	Number of sectors
/dev/sda	0x22000000	0x20000		0x1000			32
