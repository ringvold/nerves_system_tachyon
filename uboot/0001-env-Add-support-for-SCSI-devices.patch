From: Harald Ringvold <harald@ringvold.dev>
Subject: [PATCH] env: Add support for SCSI devices

Backport of the upstream U-Boot SCSI environment driver so that the
environment can be stored raw in a GPT partition on UFS storage.
The partition-UUID lookup path is dropped because scsi_get_blk_by_uuid()
does not exist in this tree; the partition is selected with
CONFIG_ENV_SCSI_HW_PARTITION instead.

Needed by Nerves for A/B firmware slot selection: fwup, libuboot
(fw_printenv) and U-Boot all read and write the same raw environment
block at the start of the uboot_env partition.
---
--- a/env/Kconfig
+++ b/env/Kconfig
@@ -463,6 +463,25 @@
 	  the environment in.  This will enable redundant environments in UBI.
 	  It is assumed that both volumes are in the same MTD partition.
 
+config ENV_IS_IN_SCSI
+	bool "Environment is in a SCSI device"
+	depends on SCSI
+	depends on PARTITIONS && CMDLINE
+	help
+	  Define this if you have a SCSI device (e.g. UFS storage) which you
+	  want to use for the environment. CONFIG_ENV_SIZE bytes are read from
+	  and written to the start of the GPT partition selected by
+	  CONFIG_ENV_SCSI_HW_PARTITION.
+
+config ENV_SCSI_HW_PARTITION
+	string "SCSI device and partition for the environment"
+	depends on ENV_IS_IN_SCSI
+	default "0:3"
+	help
+	  Device number and partition number holding the environment, in the
+	  "dev:part" format understood by blk_get_device_part_str(). The
+	  environment is stored raw at the start of this partition.
+
 config SYS_REDUNDAND_ENVIRONMENT
 	bool "Enable redundant environment support"
 	help
--- a/env/Makefile
+++ b/env/Makefile
@@ -22,6 +22,7 @@
 
 obj-$(CONFIG_$(PHASE_)ENV_IS_NOWHERE) += nowhere.o
 obj-$(CONFIG_$(PHASE_)ENV_IS_IN_MMC) += mmc.o
+obj-$(CONFIG_$(PHASE_)ENV_IS_IN_SCSI) += scsi.o
 obj-$(CONFIG_$(PHASE_)ENV_IS_IN_FAT) += fat.o
 obj-$(CONFIG_$(PHASE_)ENV_IS_IN_EXT4) += ext4.o
 obj-$(CONFIG_$(PHASE_)ENV_IS_IN_NAND) += nand.o
--- a/env/env.c
+++ b/env/env.c
@@ -61,6 +61,9 @@
 #ifdef CONFIG_ENV_IS_IN_UBI
 	ENVL_UBI,
 #endif
+#ifdef CONFIG_ENV_IS_IN_SCSI
+	ENVL_SCSI,
+#endif
 #ifdef CONFIG_ENV_IS_NOWHERE
 	ENVL_NOWHERE,
 #endif
--- /dev/null
+++ b/env/scsi.c
@@ -0,0 +1,121 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * (C) Copyright 2008-2011 Freescale Semiconductor, Inc.
+ *
+ * Environment in a SCSI device (e.g. UFS). Backport of the upstream
+ * U-Boot env/scsi.c driver with the partition-UUID lookup removed
+ * (scsi_get_blk_by_uuid() is not available in this tree).
+ */
+
+#include <asm/global_data.h>
+
+#include <command.h>
+#include <env.h>
+#include <env_internal.h>
+#include <fdtdec.h>
+#include <linux/stddef.h>
+#include <malloc.h>
+#include <memalign.h>
+#include <part.h>
+#include <search.h>
+#include <scsi.h>
+#include <errno.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+static env_t envbuf;
+
+struct env_scsi_info {
+	struct blk_desc *blk;
+	struct disk_partition part;
+	int count;
+};
+
+static struct env_scsi_info env_part;
+
+static inline struct env_scsi_info *env_scsi_get_part(void)
+{
+	static bool is_scsi_scanned;
+	struct env_scsi_info *ep = &env_part;
+
+	if (!is_scsi_scanned) {
+		scsi_scan(false /* no verbose */);
+		is_scsi_scanned = true;
+	}
+
+	if (blk_get_device_part_str("scsi", CONFIG_ENV_SCSI_HW_PARTITION,
+				    &ep->blk, &ep->part, true) < 0)
+		return NULL;
+
+	ep->count = CONFIG_ENV_SIZE / ep->part.blksz;
+
+	return ep;
+}
+
+static int env_scsi_save(void)
+{
+	struct env_scsi_info *ep = env_scsi_get_part();
+	int ret;
+
+	if (!ep)
+		return -ENOENT;
+
+	ret = env_export(&envbuf);
+	if (ret)
+		return ret;
+
+	if (blk_dwrite(ep->blk, ep->part.start, ep->count, &envbuf) != ep->count)
+		return -EIO;
+
+	return 0;
+}
+
+static int env_scsi_erase(void)
+{
+	struct env_scsi_info *ep = env_scsi_get_part();
+
+	if (!ep)
+		return -ENOENT;
+
+	return (int)blk_derase(ep->blk, ep->part.start, ep->count);
+}
+
+#if defined(ENV_IS_EMBEDDED)
+static int env_scsi_load(void)
+{
+	return 0;
+}
+#else
+static int env_scsi_load(void)
+{
+	struct env_scsi_info *ep = env_scsi_get_part();
+	int ret;
+
+	if (!ep) {
+		env_set_default("SCSI partition " CONFIG_ENV_SCSI_HW_PARTITION " not found", 0);
+		return -ENOENT;
+	}
+
+	if (blk_dread(ep->blk, ep->part.start, ep->count, &envbuf) != ep->count) {
+		env_set_default("SCSI partition " CONFIG_ENV_SCSI_HW_PARTITION " read failed", 0);
+		return -EIO;
+	}
+
+	ret = env_import((char *)&envbuf, 1, H_EXTERNAL);
+	if (ret) {
+		debug("ENV import failed\n");
+		env_set_default("Cannot load environment", 0);
+	} else {
+		gd->env_addr = (ulong)envbuf.data;
+	}
+
+	return ret;
+}
+#endif
+
+U_BOOT_ENV_LOCATION(scsi) = {
+	.location	= ENVL_SCSI,
+	ENV_NAME("SCSI")
+	.load		= env_scsi_load,
+	.save		= ENV_SAVE_PTR(env_scsi_save),
+	.erase		= ENV_ERASE_PTR(env_scsi_erase),
+};
--- a/include/env_internal.h
+++ b/include/env_internal.h
@@ -112,6 +112,7 @@
 	ENVL_NVRAM,
 	ENVL_ONENAND,
 	ENVL_REMOTE,
+	ENVL_SCSI,
 	ENVL_SPI_FLASH,
 	ENVL_UBI,
 	ENVL_NOWHERE,
