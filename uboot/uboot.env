# Custom U-Boot environment for Nerves on the Particle Tachyon
#
# This file is compiled to images/uboot-env.bin by mkenvimage and written raw
# to the start of the uboot_env partition (LUN 0, partition 11) by fwup. U-Boot
# is configured (see nerves.fragment + the env-SCSI patch) to load and save its
# environment from that same location, so U-Boot, fwup and Elixir
# (nerves_runtime / uboot_env via /etc/fw_env.config) all share one
# environment block.
#
# Storage layout, verified on hardware 2026-08-30 (see
# fwup_include/fwup-common.conf). Partitions 1-10 are the stock gen-1
# partitions, kept untouched; 11-15 are carved from the old system_a space:
#   scsi 0:11 (/dev/sda11)  uboot_env  raw env (128 KiB) at partition start
#   scsi 0:12 (/dev/sda12)  BOOT       FAT, holds Image.a, Image.b,
#                                      tachyon-a.dtb, tachyon-b.dtb
#   scsi 0:13 (/dev/sda13)  rootfs A (squashfs)
#   scsi 0:14 (/dev/sda14)  rootfs B (squashfs)
#   scsi 0:15 (/dev/sda15)  application data (f2fs)
# The stock ESP (GRUB, boot_b = /dev/sdg25) is left intact; the
# "Boot stock EFI/GRUB" menu entry below still chain-loads it (though stock
# Ubuntu itself is gone once system_a has been repartitioned).
#
# Notes:
# * kernel_addr_r / fdt_addr_r are set at runtime by U-Boot's Qualcomm board
#   code (mach-snapdragon) based on the RAM layout, so they are not set here.
# * If this environment block is missing or corrupt, U-Boot falls back to the
#   compiled-in Particle default environment, whose bootcmd is
#   "bootefi bootmgr" (stock GRUB flow). EDL restore is the recovery path.

#
# Particle/Qualcomm defaults kept from board/particle/tachyon/default.env
#

stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=scsi scan; usb start
fastboot=fastboot -l $fastboot_addr_r usb 0
menucmd=bootmenu
bootmenu_0=Boot Nerves=run nerves_boot
bootmenu_1=Enable fastboot mode=run fastboot
bootmenu_2=Boot stock EFI/GRUB=bootefi bootmgr
bootmenu_3=Reset device=reset

#
# Nerves variables
#

nerves_fw_active=a

# nerves_fw_autovalidate controls whether updates are considered valid once
# applied. If set to 0, the application must set nerves_fw_validated to 1
# before the next reboot or the previous firmware is run. If 1, no further
# action needs to be taken.
nerves_fw_autovalidate=1

# nerves_fw_validated is 1 if the current boot selection is accepted. It is
# set to 1 here since this environment is written at provisioning time, so it
# is implicitly valid.
nerves_fw_validated=1

# nerves_fw_booted is 0 for the first boot and 1 for all reboots after that.
# NOTE: Keep this '0' so that all new boards run a 'saveenv' to exercise the
#       code that writes back to UFS early on.
nerves_fw_booted=0

#
# Boot logic
#
# nerves_init checks whether this is a first boot or not. If it's not the
# first boot, then the firmware better be validated or it reverts to running
# the firmware on the opposite partition.
#

nerves_revert=\
    if test ${nerves_fw_active} = "a"; then\
        echo "Reverting to partition B";\
        setenv nerves_fw_active "b";\
    else\
        echo "Reverting to partition A";\
        setenv nerves_fw_active "a";\
    fi

nerves_init=\
    if test ${nerves_fw_booted} = 1; then\
        if test ${nerves_fw_validated} = 0; then\
            run nerves_revert;\
            setenv nerves_fw_validated 1;\
            saveenv;\
        fi;\
    else\
        setenv nerves_fw_booted 1;\
        if test ${nerves_fw_autovalidate} = 1; then\
            setenv nerves_fw_validated 1;\
        fi;\
        saveenv;\
    fi;\
    setenv bootfile Image.${nerves_fw_active};\
    setenv fdtfile tachyon-${nerves_fw_active}.dtb;\
    if test ${nerves_fw_active} = "a"; then\
        setenv uenv_root /dev/sda13;\
    else\
        setenv uenv_root /dev/sda14;\
    fi

#
# Kernel command line
#
# console  - GENI serial console on the debug connector
# quiet    - limit kernel prints to the console
#
console=ttyMSM0,115200n8
cmdline=quiet

# The kernel and device trees are loaded from the Nerves FAT BOOT partition.
# Loading from squashfs in U-Boot is slow, so the kernel stays in FAT just
# like nerves_system_bbb does.
bootpart=0:12

nerves_boot=\
    run nerves_init;\
    load scsi ${bootpart} ${kernel_addr_r} ${bootfile};\
    load scsi ${bootpart} ${fdt_addr_r} ${fdtfile};\
    setenv bootargs console=${console} root=${uenv_root} rootfstype=squashfs rootwait ${cmdline};\
    booti ${kernel_addr_r} - ${fdt_addr_r}

bootcmd=run nerves_boot
