# nerves_system_br's image plus the extra host tools Particle's U-Boot
# fork needs: xxd is used by U-Boot's Makefile to embed the default
# environment (include/generated/defaultenv_autogenerated.h).
FROM ghcr.io/nerves-project/nerves_system_br:1.34.1

USER root
RUN apt-get update -y -qq \
  && apt-get -o APT::Retries=3 install -y --no-install-recommends xxd \
  && apt-get -q -y clean \
  && rm -rf /var/lib/apt/lists/*
USER nerves

WORKDIR /home/nerves/project
